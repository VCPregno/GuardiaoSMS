    <color name="alert_safe">#2E7D32</color>
    <color name="alert_safe_bg">#E8F5E9</color>
    <color name="surface_background">#FFFFFF</color>
    <color name="text_primary">#1A1A1A</color>
    <color name="text_secondary">#5F6368</color>
</resources>
